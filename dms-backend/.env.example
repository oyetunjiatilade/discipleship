# ═══════════════════════════════════════════
#  DMS Backend — Environment Variables
#  Copy to .env and fill in real values
# ═══════════════════════════════════════════

# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://localhost:27017/dms

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP / SMS
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=TeamBarnabas
OTP_EXPIRY_MINUTES=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=dnaphb152
CLOUDINARY_API_KEY=577416881886121
CLOUDINARY_API_SECRET=WgyzK4HLYGpWVjzjZDZYIGsk24I

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug

# ── Added by DMS upgrade (NOW + NEXT) ─────────────────────────────
# SMS / WhatsApp delivery (Termii). Set SMS_PROVIDER=termii and SMS_CHANNEL=whatsapp
# to deliver OTPs and re-engagement nudges over WhatsApp.
SMS_CHANNEL=generic            # generic | dnd | whatsapp

# Cookies — refresh token is delivered as an httpOnly cookie.
# Set COOKIE_DOMAIN in production if API and web app share a parent domain.
# COOKIE_DOMAIN=.teambarnabas.org

# Seed super admin (used by `npm run seed`) — belongs to no branch; use it to create
# branches and branch admins via the API/UI. If SEED_ADMIN_PASSWORD is unset a strong
# random password is generated and printed once. Must change it on first login.
# SEED_ADMIN_EMAIL=admin@teambarnabas.org
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PHONE=+2348000000000

# One-off migration for pre-branch databases (see scripts/migrate-branches.ts):
#   npm run migrate:branches -- "Lagos HQ"

# Scheduler / re-engagement nudges
ENABLE_SCHEDULER=true          # false to disable background jobs
REENGAGEMENT_CRON=0 9 * * *    # daily 09:00 server time
NUDGE_INACTIVE_DAYS=3          # nudge converts inactive >= N days
NUDGE_COOLDOWN_DAYS=3          # don't nudge the same convert more than once per N days
