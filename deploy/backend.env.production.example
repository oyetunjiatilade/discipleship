# ═══════════════════════════════════════════════════════════════
#  DMS backend — PRODUCTION environment
#  Deployed copy lives at: /var/www/dms/shared/backend.env
#  (symlinked to dms-backend/.env by deploy/deploy.sh)
#
#  This file is the CHECKLIST. Every line marked  # ⚠ CHANGE  must be
#  set to a real production value before the first deploy. See the
#  "Production env checklist" table in deploy/README.md for the why.
# ═══════════════════════════════════════════════════════════════

# ── Server ──
NODE_ENV=production
PORT=4000
API_BASE_URL=https://discipleship.slchurchng.org        # ⚠ CHANGE (was http://localhost:4000)

# ── Database (MongoDB Atlas) ──
# Atlas → Connect → Drivers. Whitelist 62.238.33.106 in Atlas Network Access.
# Keep the /dms database name and the options below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/dms?retryWrites=true&w=majority   # ⚠ CHANGE

# ── JWT ──
# Generate two DIFFERENT secrets on the server (never commit real ones):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=__GENERATE_ME__     # ⚠ CHANGE — 48-byte hex, not the dev value
JWT_REFRESH_SECRET=__GENERATE_ME__    # ⚠ CHANGE — a second, different 48-byte hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── OTP / SMS (Termii) ──
# mock = no real SMS sent. Admin & mentor login (email+password) works either way,
# but convert phone-OTP login/registration verification needs a real provider.
SMS_PROVIDER=mock                # ⚠ CHANGE to `termii` once a key exists
SMS_API_KEY=                     # ⚠ CHANGE (Termii API key)
SMS_SENDER_ID=TeamBarnabas       # ⚠ CHANGE to an approved Termii sender ID
SMS_CHANNEL=generic              # generic | dnd | whatsapp
OTP_EXPIRY_MINUTES=5

# ── Cloudinary (media uploads) ──
# Server is UTC. Confirm this is the church's production Cloudinary account and
# ROTATE the secret — the dev value has been shared in .env.example / chat.
CLOUDINARY_CLOUD_NAME=dnaphb152              # ⚠ CONFIRM
CLOUDINARY_API_KEY=577416881886121           # ⚠ CONFIRM
CLOUDINARY_API_SECRET=WgyzK4HLYGpWVjzjZDZYIGsk24I   # ⚠ CHANGE (rotate in Cloudinary console)

# ── CORS ──
ALLOWED_ORIGINS=https://discipleship.slchurchng.org   # ⚠ CHANGE (was http://localhost:3000)

# ── Cookies ──
# Single host serves both SPA and API, so leave COOKIE_DOMAIN unset (cookie is
# host-scoped). Only set it if you later add a separate api.* subdomain.
# COOKIE_DOMAIN=.slchurchng.org

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300      # ⚠ REVIEW (dev used 1000; 300/15min/IP is saner for prod)

# ── Logging ──
LOG_LEVEL=info                   # ⚠ CHANGE (was debug)

# ── Scheduler / re-engagement nudges ──
ENABLE_SCHEDULER=true
REENGAGEMENT_CRON=0 8 * * *      # ⚠ REVIEW: server clock is UTC. 08:00 UTC = 09:00 WAT (Lagos)
NUDGE_INACTIVE_DAYS=3
NUDGE_COOLDOWN_DAYS=3

# ── Seed super admin (used once by `npm run seed`) ──
SEED_ADMIN_EMAIL=admin@slchurchng.org           # ⚠ CHANGE
SEED_ADMIN_PASSWORD=                             # ⚠ SET a strong value (or leave blank to auto-generate + print once)
SEED_ADMIN_PHONE=+2348000000000                 # ⚠ CHANGE
